<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Verification Failed</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #fef2f2; color: #333;">
    <table width="100%" height="100%" cellpadding="0" cellspacing="0" style="min-height: 100vh;">
        <tr>
            <td align="center" valign="middle">
                <table width="100%" max-width="500px" cellpadding="20" cellspacing="0" style="background-color: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); margin: 20px;">
                    <tr>
                        <td align="center">
                            <img src="https://img.icons8.com/color/96/cancel--v1.png" alt="Failed" width="80" height="80" />
                            <h2 style="color: #dc2626; margin-top: 20px;">Verification Failed - Please Update Your Email Again!</h2>
                            <p style="font-size: 16px; margin-top: 10px;"><%= message %></p>
                            <p style="font-size: 14px; color: #555; margin-top: 20px;">
                                Please try updating your email again.
                            </p>
                            <a href="https://dashboard.swipe.ai/dashboard/profile" style="display: inline-block; margin-top: 30px; padding: 10px 20px; background-color: #dc2626; color: #fff; text-decoration: none; border-radius: 5px;">
                                Go to Profile Page
                            </a>

                            <!-- Swipe.ai link styled
                            <p style="margin-top: 25px;">
                                <a href="https://swipe.ai" target="_blank" rel="noopener noreferrer" style="font-size: 16px; color: #1d4ed8; text-decoration: underline;">
                                    swipe.ai
                                </a>
                            </p>
                             -->
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
