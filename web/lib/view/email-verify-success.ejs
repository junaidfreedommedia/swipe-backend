<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Email Verified</title>
</head>
<body style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f6f8; color: #333;">
    <table width="100%" height="100%" cellpadding="0" cellspacing="0" style="min-height: 100vh;">
        <tr>
            <td align="center" valign="middle">
                <table width="100%" max-width="500px" cellpadding="20" cellspacing="0" style="background-color: #fff; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); margin: 20px;">
                    <tr>
                        <td align="center">
                            <img src="https://img.icons8.com/color/96/000000/verified-account.png" alt="Verified" width="80" height="80">
                            <h2 style="color: #2e7d32; margin-top: 20px;"><%= message %></h2>
                            <p style="font-size: 16px; margin-top: 10px;">
                                Your email has been <strong>verified</strong> and updated successfully!
                            </p>
                            <p style="font-size: 14px; color: #555; margin-top: 20px;">
                                You may now safely close this window.
                            </p>
                            <a href="https://dashboard.swipe.ai/dashboard" style="display: inline-block; margin-top: 30px; padding: 10px 20px; background-color: #2e7d32; color: #fff; text-decoration: none; border-radius: 5px;">
                                Go to Dashboard
                            </a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
