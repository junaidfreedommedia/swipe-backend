<script>
  window.cartItems = {{ cart.items | json }};
  window.cartSubtotal = {{ cart.items_subtotal_price | divided_by: 100.0 | json }};
  window.postMoneyFomat = {{ shop.money_format | json }};
  window.shopCurrency = {{ shop.currency | json }};
  window.swipeDynamicConfigEnabled = {{ shop.metafields.swipe.dynamic_config_enabled.value | json }};

  // 👇 IMPORTANT: define your Swipe product handle here
  window.SWIPE_PRODUCT_HANDLE = "swipe";
</script>

<div 
  class="post-protect_cart" 
  data-shop="{{ shop.id }}"
  data-dynamic-enabled="{{ shop.metafields.swipe.dynamic_config_enabled.value | escape }}"
  style="display:none;">
  
  <div class="post-protect_container">
    <div class="pp-toggle-wrapper">
      
      <form class="pp-checkbox">
        <input type="checkbox" id="post_protection_checkbox" />
        <label for="post_protection_checkbox">Toggle</label>
      </form>

      <div 
        class="pp-price" 
        data-money="{{ shop.money_format | escape }}">
      </div>

    </div>
  </div>
</div>

<script src="{{ 'app.js' | asset_url }}?v={{ 'now' | date: '%s' }}" defer></script>

{% schema %}
{
  "name": "Swipe Cart Widget",
  "target": "head",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": []
}
{% endschema %}
